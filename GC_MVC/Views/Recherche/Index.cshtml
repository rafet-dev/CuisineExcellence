@using GC_MVC.Models
@model List<GC_MVC.Models.Recettes>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Recherche";
} 

<h1>Recherche</h1>
    <div class="recherche-filtre">
        <form id="formulaireRecherche" class="recherche" asp-controller="Recherche" asp-action="Index" method="get">
            <input type="text" id="champRecherchePage" name = "terme" placeholder="Rechercher une recette, un ingrédient...">
            <button type="submit" id="boutonRecherche" aria-label="Rechercher">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle>
                    <line x1="16.5" y1="16.5" x2="22" y2="22"></line>
                </svg>
            </button>
        </form>
        <div class="filtre">
            <div class="info">
                <label for="choix-tps-prep">Temps global de préparation :</label>
                <select id="choix-tps-prep" name="liste-de-tps">
                    <option value="option1">moins de 20 minutes</option>
                    <option value="option2">20 - 30 minutes</option>
                    <option value="option3">30 - 45 minutes</option>
                    <option value="option4">45 minutes - 60 minutes</option>
                    <option value="option5"> + d'une heure </option>
                </select>
            </div>

            <div class="info">
                <label class="diff">Difficulté :</label>
                <div class="rating">
                    <label><input type="radio" name="niveau-diff" value="1"><i data-lucide="chef-hat" class="toque-active"></i></label>
                    <label><input type="radio" name="niveau-diff" value="2"><i data-lucide="chef-hat" class="toque-active"></i><i data-lucide="chef-hat" class="toque-active"></i></label>
                    <label><input type="radio" name="niveau-diff" value="3"><i data-lucide="chef-hat" class="toque-active"></i><i data-lucide="chef-hat" class="toque-active"></i><i data-lucide="chef-hat" class="toque-active"></i></label>
                    <label><input type="radio" name="niveau-diff" value="4"><i data-lucide="chef-hat" class="toque-active"></i><i data-lucide="chef-hat" class="toque-active"></i><i data-lucide="chef-hat" class="toque-active"></i><i data-lucide="chef-hat" class="toque-active"></i></label>
                    <label><input type="radio" name="niveaudiff" value="5"> <i data-lucide="chef-hat" class="toque-active"></i><i data-lucide="chef-hat" class="toque-active"></i><i data-lucide="chef-hat" class="toque-active"></i><i data-lucide="chef-hat" class="toque-active"></i><i data-lucide="chef-hat" class="toque-active"></i></label>
                </div>
            </div>

            <div class="info">
                <label class="diff">Note :</label>

                <div class="rating">
                    <label><input type="radio" name="niveau-note" value="1"> ★</label>
                    <label><input type="radio" name="niveau-note" value="2"> ★★</label>
                    <label><input type="radio" name="niveau-note" value="3"> ★★★</label>
                    <label><input type="radio" name="niveau-note" value="4"> ★★★★</label>
                    <label><input type="radio" name="niveau-note" value="5"> ★★★★★</label>
                </div>
            </div>

            <div class="info">
                <label for="categorie">Categorie : </label>
                <select id="categorie" name="categorie" form="formulaireRecherche">
                    <option value="">Toutes les catégories</option>
                    @foreach(Categories categories in ViewBag.Categories)
                    {
                        <option value="@categories.id_categorie">@categories.nom</option>
                    }
                </select>
            </div>
        </div>
    </div>
<h1>Résultats de la recherche</h1>

@if (ViewBag.RechercheEffectuee == false)
{
    <p>Saisissez un terme pour rechercher une recette.</p>
}
else if (Model.Count == 0)
{
    <p>Aucun résultat trouvé.</p>
}
else
{
    <div class="grille-recettes">
        @foreach (GC_MVC.Models.Recettes recette in Model)
        {
            <div class="resultat-recette">
                <img src="~/img/recettes/@recette.photo" alt="@recette.nom"/>
                <a asp-controller="Recettes" asp-action="Detail" asp-route-id="@recette.id_recette"><h2>@recette.nom</h2></a>
            </div>
        }
    </div>
    
}

@section Styles {
    <link rel="stylesheet" href="~/CSS/styleRecherche.css" />
} 

@section Scripts {
    <script src="~/js/recherche.js"></script>
}