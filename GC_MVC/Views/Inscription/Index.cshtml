@model GC_MVC.ViewModels.InscriptionViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Inscription";
}

<h1>Inscription nouveau membre</h1>

<div class="fond-inscription">
    <div class="inscription">

        <form asp-controller="Access" asp-action="Inscription" method="post">

            <div class="ligne-inscription">
                <label asp-for="Identifiant">Votre identifiant :</label>
                <input asp-for="Identifiant" type="text" id="identifiant" required />
            </div>

            <div class="ligne-inscription">
                <label asp-for="Email">Votre email :</label>
                <input asp-for="Email" type="email" id="email" required />
            </div>

            <div class="ligne-inscription">
                <label asp-for="MotDePasse">Votre mot de passe :</label>
                <input asp-for="MotDePasse" type="password" id="password" required />
            </div>

            <div class="ligne-inscription">
                <label for="password-2">Confirmez votre mot de passe :</label>
                <input asp-for="ConfirmationMotDePasse" type="password" id="password-2" required />
            </div>

            <div class="button-club">
                <button type="submit">Je rejoins le club GC</button>
            </div>

        </form>

    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/CSS/styleInscription.css" />
}
