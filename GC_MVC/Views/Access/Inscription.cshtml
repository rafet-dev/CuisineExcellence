@model InscriptionViewModel
@{
    ViewData["Title"] = "Inscription";
}

<h1>Inscription</h1>
<form asp-action="Inscription" asp-controller="Access" method="post">
    <div>
        <label asp-for="@Model.Identifiant"></label>
        <input asp-for="@Model.Identifiant">
        <span asp-validation-for="@Model.Identifiant" class="text-danger"></span>
    </div>  
    <div>
        <label asp-for="@Model.Email"></label>
        <input asp-for="@Model.Email">
        <span asp-validation-for="@Model.Email" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="@Model.MotDePasse"></label>
        <input type="password" asp-for="@Model.MotDePasse">
        <span asp-validation-for="@Model.MotDePasse" class="text-danger"></span>
    </div>
    <input type="submit" value="S'inscrire">
</form>