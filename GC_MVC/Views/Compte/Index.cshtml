
@model GC_MVC.ViewModels.CompteViewModel

@{
    ViewData["Title"] = "Mon compte";
}

<h2>Bienvenue @Model.Identifiant !</h2>

@if (TempData["MessageSucces"] != null)
{
    <div class="message-succes">
        @TempData["MessageSucces"]
    </div>
}

<main>
    <h1>Mon compte</h1>

    <section class="MesRecettes">
        
        <a asp-controller="Recettes" asp-action="MesRecettes">
            <h2>Mes recettes</h2>
            <p>Retrouvez ici toutes les recettes que vous avez créées.</p>
        </a>

    </section>
    
    <section>Créer une recette</section>
    <section>Mes avis et commentaires</section>
    <section>Mes favoris</section>
    <section>Mes informations personnelles</section>
</main>



   


