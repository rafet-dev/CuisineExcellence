@model List<GC_MVC.Models.Categories>

<h1>Categories</h1>
<ul>
    @foreach (GC_MVC.Models.Categories categorie in Model)
    {
        <li>
            <!--
                asp-controller : contrôleur que l'on souhaite appeler
                asp-action     : méthode (Action) du contrôleur à appeler
                asp-route-id   : valeur envoyée dans le paramètre "id"
            -->
            <a asp-controller="Categories"
               asp-action="Recettes"
               asp-route-id="@categorie.id_categorie">
                @categorie.nom
            </a>
        </li>
    }
</ul>