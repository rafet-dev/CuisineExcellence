@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Accueil";
}  
    <h1>Bienvenue à tous les passionnés & passionnées de cuisine !</h1>
        <section class="contenu">
            <div class="presentation">
                <img src="~/img/logo/logo_transparent.png" alt="Gastronome créatif" />
                <p class="slogan">L'art de la cuisine autrement.</p>
                <a href="#" class="bouton-recettes">Découvrir nos recettes</a>
            </div>
        </section>
        <!-- section Actualités -->
        <section class="actualite">
            <h1>Actualités</h1>
            <div class="fond-actualite">
            <div class="section-actualite">
                <div class="actualite1">
                    <img src="~/img/illustrations/aubergine-saucisse-de-morteau.jpeg" />
                    <div class="texte-actualite">
                        <p>Saucisse de Morteau à l'aubergine</p>
                    </div>
                </div>

                <div class="actualite1">
                    <img src="~/img/illustrations/saumon-315x420.jpeg" />
                    <div class="texte-actualite">
                        <p>Saumon à la plancha, crème au wasabi</p>
                    </div>
                </div>

                <div class="actualite1">
                    <img src="~/img/illustrations/pizza-pasteque-315x420.jpg" />
                    <div class="texte-actualite">
                        <p>Pizza à la pastèque</p>
                    </div>
                </div>
            </div>
            <div class="button-actualite">
                <button>Voir toutes les actualités</button>
            </div>
            </div>
        </section>
        <!-- section citations -->
        <section class="citations">
            <h1>Citations</h1>
            <div class="fond-citation">
                <div class="slide">
                    <p>La bonne cuisine est honnête, sincère et simple.</p>
                    <p>Elisabeth David, écrivaine de livres de cuisine</p>
                </div>
                <div class="slide">
                    <p>La cuisine, c'est donner de la mémoire à l'éphémère.</p>
                    <p>Thierry Marx, chef cuisinier</p>
                </div>
                <div class="slide">
                    <p>Faites simple et donnez du goût à chaque bouchée.</p>
                    <p>Joël Robuchon, chef cuisinier</p>
                </div>
                <div class="slide">
                    <p>Cuisiner c'est imaginer, inventer, créer et partager.</p>
                    <p>Anne-Sophie Pic</p>
                </div>
                <div class="slide">
                    <p>Classique ou moderne, il n'y a qu'une seule cuisine... La bonne.</p>
                    <p>Paul Bocuse</p>
                </div>
            </div>
        </section>

        <!-- section recette à la une -->
        <section class="recette">
            <h1>Recettes à la une</h1>
            <div class="fond-recette">
            <div class="section-recette">
                <div class="recette1">
                    <img src="~/img/illustrations/aubergine-saucisse-de-morteau.jpeg" />
                    <div class="texte-recette1">
                        <p>Saucisse de Morteau à l'aubergine</p>
                        <div class="notation">

                            <span class="etoile">★</span>
                            <span class="etoile">★</span>
                            <span class="etoile">★</span>
                            <span class="etoile">★</span>
                            <span class="etoile">★</span>
                            <br>
                            <span class="note">4,5/5</span>
                        </div>
                    </div>
                </div>

                <div class="recette1">
                    <img src="~/img/illustrations/saumon-315x420.jpeg" />
                    <div class="texte-recette1">
                        <p>Saumon à la plancha, crème au wasabi</p>
                        <div class="notation">

                            <span class="etoile">★</span>
                            <span class="etoile">★</span>
                            <span class="etoile">★</span>
                            <span class="etoile">★</span>
                            <span class="etoile">★</span>

                            <span class="note">4,5/5</span>
                        </div>
                    </div>
                </div>

                <div class="recette1">
                    <img src="~/img/illustrations/pizza-pasteque-315x420.jpg" />
                    <div class="texte-recette1">
                        <p>Pizza à la pastèque</p>
                        <div class="notation">

                            <span class="etoile">★</span>
                            <span class="etoile">★</span>
                            <span class="etoile">★</span>
                            <span class="etoile">★</span>
                            <span class="etoile">★</span>

                            <span class="note">4,5/5</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="button-recette">
                <button>Voir nos autres recettes gourmandes</button>
            </div>
        </div>
        </section>
        <!-- section rejoindre le club -->
        <section class="club">
            <h1>Rejoindre le club</h1>
            <div class="club-img">
                <img src="~/img/club/contribuer.png" />
                <img src="~/img/club/manger.png" />
                <img src="~/img/club/menuSemaine.png" />
                <img src="~/img/club/noter.png" />
                <img src="~/img/club/nouveaute.png" />
                <img src="~/img/club/sauvegarder.png" />
            </div>    
            <div class="button-club">
                <button>Rejoindre le club GC</button>
            </div>
            </div>  
        </section>

@section Styles {
    <link rel="stylesheet" href="~/CSS/styleHome.css" />
} 