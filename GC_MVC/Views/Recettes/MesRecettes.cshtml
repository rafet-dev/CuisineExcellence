@using GC_MVC.Models
@model List<Recettes>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Mes Recettes";
}

<main>
    <h1>Mes Recettes</h1>
        @if (Model.Count == 0)
        {
            <p>Vous n'avez pas encore créé de recette !</p>
        }
        else 
        {
            <ul>
                @foreach(Recettes recette in Model)
                    {
                        <li>@recette.nom</li>
                    }
            </ul>
        }
</main>
